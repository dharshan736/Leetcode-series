class Solution:
    def leastInterval(self, tasks: List[str], n: int) -> int:
        count=Counter(tasks)
        heap=[-i for i in count.values()]
        heapq.heapify(heap)
        q=deque([])
        time=0
        while heap or q:
            time+=1
            if heap:
                val=heapq.heappop(heap)
                if val<-1:
                    q.append((val+1,time+n))
            if q and q[0][1]==time:
                heapq.heappush(heap,q.popleft()[0])
        return time
        
