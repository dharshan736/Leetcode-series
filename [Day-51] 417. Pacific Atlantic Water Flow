class Solution:
    def pacificAtlantic(self, heights: List[List[int]]) -> List[List[int]]:
        pacific=deque()
        altantic=deque()
        m=len(heights)
        n=len(heights[0])
        for i in range(m):
            pacific.append((i,0))
        for j in range(n):
            pacific.append((0,j))
        for i in range(m):
            altantic.append((i,n-1))
        for j in range(n):
            altantic.append((m-1,j))
        def water_flow(pacific):
            water=set()
            while pacific:
                k=pacific.popleft()
                i,j=k
                if (i, j) in water:
                    continue
                water.add((i,j))

                for k in ((1,0),(0,1),(-1,0),(0,-1)):
                    pos_i,pos_j=i+k[0],j+k[1]
                    if 0<=pos_i<m and 0<=pos_j<n:
                        if heights[pos_i][pos_j]>=heights[i][j]:
                            pacific.append((pos_i,pos_j))
            return water
        ans1=water_flow(pacific)
        ans2=water_flow(altantic)
        res=[]
        print(ans1&ans2)
        res = [[i, j] for (i, j) in ans1 & ans2]
        return res        


            
        
