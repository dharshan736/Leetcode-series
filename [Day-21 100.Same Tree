# Definition for a binary tree node.
# class TreeNode(object):
#     def __init__(self, val=0, left=None, right=None):
#         self.val = val
#         self.left = left
#         self.right = right
class Solution(object):
    def isSameTree(self, p, q):
        res=[True]
        def dfs(p,q):
            if not p and not q:
                return 
            if not p or not q or p.val!=q.val:
                res[0]=False
                return
            dfs(p.left,q.left)
            dfs(p.right,q.right)
        dfs(p,q)
        return res[0]
        
