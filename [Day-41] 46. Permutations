class Solution:
    def permute(self, nums: List[int]) -> List[List[int]]:
        res=[]
        n=len(nums)
        def backtrack(used,cur):
            if len(cur[:])==n:
                res.append(cur[:])
                return 
            for i in range(n):
                if used[i]:
                    continue
                cur.append(nums[i])
                used[i]=True
                backtrack(used,cur)
                used[i]=False
                cur.pop()
        backtrack([False]*n,[])
        return res
            
