class Solution:
    def orangesRotting(self, grid: List[List[int]]) -> int:
        #rotten=0
        fresh=0
        queue=deque()
        m=len(grid)
        n=len(grid[0])
        count=0
        for i in range(m):
            for j in range(n):
                if grid[i][j]==2:
                    queue.append(((i,j),0))
                    #rotten+=1
                elif grid[i][j]==1:
                    fresh+=1
                
        while queue:
            check=queue.popleft()
            pos,val=check
            i,j=pos
            for k in ((1,0),(0,1),(-1,0),(0,-1)):
                pos_i,pos_j=i+k[0],j+k[1]
                if 0<=pos_i<m and 0<=pos_j<n:
                    if grid[pos_i][pos_j]==1:
                        grid[pos_i][pos_j]=2
                        count=max(count,val+1)
                        queue.append(((pos_i,pos_j),val+1))
                        fresh-=1
        if fresh>0:
            return -1
        return count
    
                
        
