class Solution(object):
    def isAnagram(self, s, t):
        if len(s)!=len(t):
            return False
        s1=[0]*26
        s2=[0]*26
        for i in range(len(s)):
            s1[ord(s[i])-ord('a')]+=1
            s2[ord(t[i])-ord('a')]+=1
        if s1==s2:
            return True
        return False
