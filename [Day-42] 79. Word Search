class Solution:
    def exist(self, board: List[List[str]], word: str) -> bool:
        n=len(board)
        m=len(board[0])
        w=len(word)
        def backtrack(pos,index):
            if index==w:
                return True
            i,j=pos
            if board[i][j]!=word[index]:
                return False
            char=board[i][j]
            board[i][j]="#"
            for k in ((1,0),(0,1),(-1,0),(0,-1)):
                pos_i,pos_j=i+k[0],j+k[1]
                if 0<=pos_i<n and 0<=pos_j<m:
                    if backtrack((pos_i,pos_j),index+1):
                        return True
            board[i][j]=char
            return False
        for i in range(n):
            for j in range(m):
                if board[i][j]==word[0]:
                    if backtrack((i,j),0):
                        #print(board)
                        return True
        #print(board)
        return False
