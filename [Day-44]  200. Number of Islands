class Solution:
    def numIslands(self, grid: List[List[str]]) -> int:
        count=0
        m=len(grid)
        n=len(grid[0])
        def backtrack(pos):
            i,j=pos
            grid[i][j]="#"
            for k in ((1,0),(0,1),(-1,0),(0,-1)):
                pos_i,pos_j=i+k[0],j+k[1]
                if 0<=pos_i<m and 0<=pos_j<n:
                    if grid[pos_i][pos_j]=="1":
                        backtrack((pos_i,pos_j))

        for i in range(m):
            for j in range(n):
                if grid[i][j]=="1":
                    backtrack((i,j))
                    #print(grid)
                    count+=1
        return count
        
