class Solution:
    def islandPerimeter(self, grid: List[List[int]]) -> int:
        perimeter=0
        m=len(grid)
        n=len(grid[0])
        for i in range(m):
            for j in range(n):
                if grid[i][j]==1:
                    for k in ((1,0),(0,1),(-1,0),(0,-1)):
                        pos_i,pos_j=i+k[0],j+k[1]
                        if 0<=pos_i<m and 0<=pos_j<n:
                            if grid[pos_i][pos_j]==0:
                                perimeter+=1
                        else:
                             perimeter+=1
        return perimeter
        
