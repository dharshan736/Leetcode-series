class Solution:
    def goodNodes(self, root: TreeNode) -> int:
        count=0
        #maxval=float('-inf')
        #self.count=0
        def dfs(root,maxval):
            if not root :
                return 0
            maxval=max(maxval,root.val)
            good = 1 if root.val>=maxval else 0
            return good +dfs(root.left,maxval) + dfs(root.right,maxval)
        #dfs(root,maxval)
        return dfs(root,float('-inf'))

        
