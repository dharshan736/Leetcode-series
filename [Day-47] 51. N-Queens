class Solution:
    def solveNQueens(self, n: int) -> List[List[str]]:
        col=set()
        posdiagonal=set()
        negdiagonal=set()
        board=[["."]*n for _ in range(n)]
        res=[]

        def backtrack(i):
            if i==n:
                res.append(["".join(_) for _ in board])
                return
            for j in range(n):
                if j not in col and i-j not in negdiagonal and i+j not in posdiagonal:
                    col.add(j)
                    negdiagonal.add(i-j)
                    posdiagonal.add(i+j)
                    board[i][j]="Q"

                    backtrack(i+1)

                    board[i][j]="."
                    col.remove(j)
                    negdiagonal.remove(i-j)
                    posdiagonal.remove(i+j)
        backtrack(0)
        return res

