class Solution:
    def subsetsWithDup(self, nums: List[int]) -> List[List[int]]:
        nums.sort()
        n=len(nums)
        res=[]
        cur=[]
        def backtrack(pos):
            #if len==n:
            res.append(cur[:])
            prev=''
            for i in range(pos,n):
                if i > pos and nums[i] == nums[i-1]:
                    continue
                #backtrack(i+1)
                cur.append(nums[i])
                backtrack(i+1)
                cur.pop()
                prev=nums[i]
        backtrack(0)
        return res
