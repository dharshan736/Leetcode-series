class Solution:
    def longestPalindrome(self, s: str) -> str:
        res=''
        length=len(s)
        m=0
        def palindrome(l,r):
            nonlocal res,m
            while l>=0 and r<length and s[l]==s[r]:
                if r-l+1 > m:
                    m=r-l+1
                    res=s[l:r+1]
                l-=1
                r+=1
        for i in range(length):
            palindrome(i,i)
            palindrome(i,i+1)
        return res
        
