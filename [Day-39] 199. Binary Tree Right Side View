# Definition for a binary tree node.
# class TreeNode:
#     def __init__(self, val=0, left=None, right=None):
#         self.val = val
#         self.left = left
#         self.right = right
class Solution:
    def rightSideView(self, root: Optional[TreeNode]) -> List[int]:
        if not root:
            return []
        res=[]
        queue=deque([root])
        while queue:
            k=False
            size=len(queue)
            for _ in range(size):
                element=queue.popleft()
                k=element.val
                if element.left:
                    queue.append(element.left)
                if element.right:
                    queue.append(element.right)
            #if k!=False:
            res.append(k)
        return res

        
