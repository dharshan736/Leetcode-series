class Solution:
    def combinationSum(self, candidates: List[int], target: int) -> List[List[int]]:
        res=[]
        cur=[]
        n=len(candidates)
        def dfs(i):
            if sum(cur)>target:
                return 
            if sum(cur)==target:
                res.append(cur[:])
                return 
            if i==n:
                return
            dfs(i+1)
            cur.append(candidates[i])
            dfs(i)
            cur.pop()
        dfs(0)
        return res
        
