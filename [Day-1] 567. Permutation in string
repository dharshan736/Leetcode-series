class Solution:
    def checkInclusion(self, s1: str, s2: str) -> bool:
        counter1=defaultdict(int)
        counter2=defaultdict(int)
        for i in s1:
            counter1[i]+=1
        l=0
        r=0
        while r<len(s2):
            if s2[r] in counter1:
                counter2[s2[r]]+=1
                while counter2[s2[r]]>counter1[s2[r]]:
                    counter2[s2[l]]-=1
                    l+=1
                if r-l+1 == len(s1):
                    return True 
            else:
                l=r+1
                counter2=defaultdict(int)
            r+=1
        return False
        
