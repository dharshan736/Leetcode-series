class Solution:
    def partition(self, s: str) -> List[List[str]]:
        res=[]
        cur=[]
        n=len(s)
        def backtrack(pos):
            if pos>=n:
                res.append(cur[:])
                return 
            for i in range(pos,n):
                k=s[pos:i+1]
                if k==k[::-1]:
                    cur.append(k)
                    #print(cur)
                    backtrack(i+1)
                    cur.pop()
        backtrack(0)
        return res

        
