class Solution:
    def solve(self, board: List[List[str]]) -> None:
        """
        Do not return anything, modify board in-place instead.
        """
        m=len(board)
        n=len(board[0])
        def dfs(i,j):
            if i<0 or j<0 or i>=m or j>=n or board[i][j]=="X" or board[i][j]=="T":
                return 
            board[i][j]="T"
            dfs(i+1,j)
            dfs(i-1,j)
            dfs(i,j-1)
            dfs(i,j+1)
        for i in range(m):
            for j in range(n):
                if (i in [m-1,0] or j in [n-1,0]) and board[i][j]=="O":
                    dfs(i,j)
        for i in range(m):
            for j in range(n):
                if board[i][j]=="O":
                    board[i][j]="X"
        for i in range(m):
            for j in range(n):
                if board[i][j]=="T":
                    board[i][j]="O"
                    
        
