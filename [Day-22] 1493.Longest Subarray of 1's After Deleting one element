class Solution:
    def longestSubarray(self, nums: List[int]) -> int:
        l=0
        r=0
        seen=[0]*2
        size=0
        for r in range(len(nums)):
            seen[nums[r]]+=1
            if nums[r]==0:
                while seen[nums[r]] >1:
                    seen[nums[l]]-=1
                    l+=1
            size=max(size,r-l)
        return size


    
        

            
